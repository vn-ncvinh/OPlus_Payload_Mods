#!/system/bin/sh

# Multi-device OPlus modded recovery installer.
# Streams sparse super.img directly to the existing super block device and
# flashes OTA_FILES_HERE firmware images without modifying the GPT.

OUTFD="$2"
ZIPFILE="$3"
UI_PATH=""
WORKDIR="/tmp/oplus-mods-installer"
BYNAME="/dev/block/by-name"
SUPER_DEV="$BYNAME/super"
SUPER_ENTRY="OTA_FILES_HERE/super.img"
EFISP_ENTRY="efisp-gbl-chainload-mode1.efi"
WRITER_ENTRY="tools/arm64/sparse_stream_writer"
WRITER="$WORKDIR/sparse_stream_writer"
ZIP_STREAMER_ENTRY="tools/arm64/stored_zip_streamer"
ZIP_STREAMER="$WORKDIR/stored_zip_streamer"
FIRMWARE_LIST="$WORKDIR/firmware-images.txt"
REQUIRED_IMAGES_ENTRY="required-images.txt"
REQUIRED_IMAGES_LIST="$WORKDIR/required-images.txt"
DEVICE_PROFILE_ENTRY="device-profile.conf"
DEVICE_PROFILE_FILE="$WORKDIR/device-profile.conf"
SUPER_WRITTEN=0
FLASH_ABL=0

TARGET_SUPER_BYTES=""

if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    UI_PATH="/proc/self/fd/$OUTFD"
fi

ui_print() {
    if [ -n "$UI_PATH" ]; then
        echo "ui_print $*" > "$UI_PATH"
        echo "ui_print" > "$UI_PATH"
    else
        echo "$*"
    fi
}

print_box() {
    INNER_WIDTH=31
    TEXT="$(printf '%.31s' "$1")"
    TEXT_LENGTH=${#TEXT}
    TOTAL_PAD=$((INNER_WIDTH - TEXT_LENGTH))
    LEFT_PAD=$((TOTAL_PAD / 2))
    RIGHT_PAD=$((TOTAL_PAD - LEFT_PAD))
    LEFT_SPACES=""
    RIGHT_SPACES=""

    I=0
    while [ "$I" -lt "$LEFT_PAD" ]; do
        LEFT_SPACES="$LEFT_SPACES "
        I=$((I + 1))
    done

    I=0
    while [ "$I" -lt "$RIGHT_PAD" ]; do
        RIGHT_SPACES="$RIGHT_SPACES "
        I=$((I + 1))
    done

    ui_print "###################################"
    ui_print "# $LEFT_SPACES$TEXT$RIGHT_SPACES #"
    ui_print "###################################"
    ui_print ""
}

show_progress() {
    [ -n "$UI_PATH" ] && echo "progress $1 $2" > "$UI_PATH"
}

set_progress() {
    [ -n "$UI_PATH" ] && echo "set_progress $1" > "$UI_PATH"
}

cleanup() {
    rm -rf "$WORKDIR"
}

abort() {
    ui_print ""
    ui_print "ERROR: $*"
    ui_print "The GPT was not changed."
    [ "$SUPER_WRITTEN" -eq 1 ] && ui_print "super was written before this error."
    ui_print "Remain in recovery and review the recovery log."
    exit 1
}

is_uint() {
    case "$1" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_mounted() {
    grep -q " $1 " /proc/mounts 2>/dev/null
}

package_has_file() {
    unzip -l "$ZIPFILE" "$1" 2>/dev/null |
        awk -v wanted="$1" '$4 == wanted {found=1} END {exit !found}'
}

package_file_size() {
    unzip -l "$ZIPFILE" "$1" 2>/dev/null |
        awk -v wanted="$1" '$4 == wanted {print $1; exit}'
}

prepare_device_profile() {
    package_has_file "$DEVICE_PROFILE_ENTRY" || abort "Missing $DEVICE_PROFILE_ENTRY"
    unzip -p "$ZIPFILE" "$DEVICE_PROFILE_ENTRY" > "$DEVICE_PROFILE_FILE" 2>/dev/null ||
        abort "Cannot extract $DEVICE_PROFILE_ENTRY"
    [ -s "$DEVICE_PROFILE_FILE" ] || abort "$DEVICE_PROFILE_ENTRY is empty"
    . "$DEVICE_PROFILE_FILE"

    [ -n "$DEVICE_ID" ] || abort "Device profile has no ID"
    [ -n "$DEVICE_DISPLAY" ] || abort "Device profile has no display name"
    [ -n "$SUPPORTED_PROJECT_IDS" ] || abort "Device profile has no project IDs"
    is_uint "$TARGET_SUPER_BYTES" || abort "Device profile has invalid super size"
    [ "$TARGET_SUPER_BYTES" -gt 0 ] || abort "Device profile has empty super size"
}

package_firmware_list() {
    unzip -l "$ZIPFILE" "OTA_FILES_HERE/*.img" 2>/dev/null |
        awk '{
            prefix = "OTA_FILES_HERE/"
            if (index($4, prefix) == 1) {
                name = substr($4, length(prefix) + 1)
                if (index(name, "/") == 0 && length(name) > 4 &&
                    substr(name, length(name) - 3) == ".img")
                    print $4
            }
        }' |
        sort
}

partition_for_entry() {
    NAME="$(basename "$1")"
    case "$NAME" in
        *.img) PART="${NAME%.img}" ;;
        *) abort "Unsupported firmware filename: $NAME" ;;
    esac
}

prepare_required_images() {
    package_has_file "$REQUIRED_IMAGES_ENTRY" ||
        abort "Missing $REQUIRED_IMAGES_ENTRY"
    unzip -p "$ZIPFILE" "$REQUIRED_IMAGES_ENTRY" > "$REQUIRED_IMAGES_LIST" 2>/dev/null ||
        abort "Cannot extract $REQUIRED_IMAGES_ENTRY"
    [ -s "$REQUIRED_IMAGES_LIST" ] || abort "$REQUIRED_IMAGES_ENTRY is empty"

    while IFS= read -r ENTRY || [ -n "$ENTRY" ]; do
        case "$ENTRY" in
            OTA_FILES_HERE/*.img|efisp-gbl-chainload-mode1.efi) ;;
            *) abort "Invalid required image entry: $ENTRY" ;;
        esac
        NAME="${ENTRY#OTA_FILES_HERE/}"
        case "$NAME" in
            */*|"") abort "Invalid required image entry: $ENTRY" ;;
        esac
        package_has_file "$ENTRY" || abort "Missing required image: $ENTRY"
        # Recovery unzip implementations commonly report 0 for ZIP64 entries
        # larger than 4 GiB. super.img is validated by the ZIP64 streamer and
        # sparse writer immediately before it is written.
        [ "$ENTRY" = "$SUPER_ENTRY" ] && continue
        IMAGE_SIZE="$(package_file_size "$ENTRY")"
        is_uint "$IMAGE_SIZE" || abort "Cannot read size of $ENTRY"
        [ "$IMAGE_SIZE" -gt 0 ] || abort "$ENTRY is empty"
    done < "$REQUIRED_IMAGES_LIST"
}

prepare_firmware_list() {
    package_firmware_list > "$FIRMWARE_LIST" ||
        abort "Cannot read firmware image list"
    [ -s "$FIRMWARE_LIST" ] || abort "No firmware images found in package"

    while IFS= read -r ENTRY; do
        partition_for_entry "$ENTRY"

        case "$PART" in
            super|recovery)
                continue
                ;;
        esac

        is_supported_firmware "$PART" ||
            abort "Unsupported image in OTA_FILES_HERE: $NAME"

        IMAGE_SIZE="$(package_file_size "$ENTRY")"
        is_uint "$IMAGE_SIZE" || abort "Cannot read size of $ENTRY"
        [ "$IMAGE_SIZE" -gt 0 ] || abort "$ENTRY is empty"
    done < "$FIRMWARE_LIST"
}

is_supported_firmware() {
    case "$1" in
        abl|aop|aop_config|bluetooth|boot|cpucp|cpucp_dtb|dcp|devcfg|dsp|dtbo|\
        engineering_cdt|featenabler|hyp|hyp_ac_config|imagefv|init_boot|\
        keymaster|modem|multiimgoem|multiimgqti|oplus_sec|pdp|pdp_cdb|\
        pvmfw|qtvm_dtbo|qupfw|secretkeeper|shrm|soccp|soccp_dcd|\
        soccp_debug|splash|spuservice|tme_config|tme_fw|tme_seq_patch|tz|\
        tz_ac_config|tz_qti_config|uefi|uefisecapp|vbmeta|vbmeta_system|\
        vbmeta_vendor|vendor_boot|vm-bootsys|xbl|xbl_ac_config|xbl_config|\
        xbl_ramdump)
            return 0
            ;;
    esac
    return 1
}

volume_key() {
    while true; do
        getevent -t -l -c 4 > "$WORKDIR/events" 2>&1
        if grep -q "KEY_VOLUMEUP[[:space:]]*DOWN" "$WORKDIR/events"; then
            print_box "Detected Vol+"
            return 0
        fi
        if grep -q "KEY_VOLUMEDOWN[[:space:]]*DOWN" "$WORKDIR/events"; then
            print_box "Detected Vol-"
            return 1
        fi
    done
}

confirm_install() {
    print_box "Package checks passed"
    ui_print "###################################"
    ui_print "#     Continue installation?      #"
    ui_print "#   Vol+ CONTINUE   Vol- CANCEL   #"
    ui_print "###################################"
    ui_print ""

    if volume_key; then
        print_box "Installation confirmed"
        return 0
    fi

    print_box "Installation cancelled"
    ui_print "No partitions were changed."
    ui_print "No images were flashed."
    cleanup
    exit 1
}

ask_flash_abl() {
    ui_print "###################################"
    ui_print "#           Flash ABL?            #"
    ui_print "#      Vol+ YES      Vol- NO      #"
    ui_print "###################################"
    ui_print ""

    if volume_key; then
        FLASH_ABL=1
        print_box "ABL will be flashed"
    else
        FLASH_ABL=0
        print_box "Keeping the current ABL"
    fi
}

unmount_for_install() {
    print_box "Unmounting partitions"
    for MOUNTPOINT in /system_root /system /system_ext /vendor /product /odm; do
        umount "$MOUNTPOINT" >/dev/null 2>&1
    done

    for MOUNTPOINT in /system_root /system /system_ext /vendor /product /odm; do
        is_mounted "$MOUNTPOINT" && abort "$MOUNTPOINT is still mounted"
    done
}

resolve_targets() {
    PART="$1"
    PART_A="$BYNAME/$PART"_a
    PART_B="$BYNAME/$PART"_b
    PART_SINGLE="$BYNAME/$PART"
    TARGETS=""

    if [ -e "$PART_A" ] || [ -e "$PART_B" ]; then
        [ -e "$PART_A" ] && [ -e "$PART_B" ] ||
            abort "Only one slot exists for $PART"
        TARGETS="$PART_A $PART_B"
    elif [ -e "$PART_SINGLE" ]; then
        TARGETS="$PART_SINGLE"
    else
        abort "No block partition found for $PART"
    fi
}

flash_firmware_image() {
    ENTRY="$1"
    partition_for_entry "$ENTRY"

    is_supported_firmware "$PART" ||
        abort "Unsupported image in OTA_FILES_HERE: $NAME"

    IMAGE_SIZE="$(package_file_size "$ENTRY")"
    is_uint "$IMAGE_SIZE" || abort "Cannot read size of $ENTRY"
    [ "$IMAGE_SIZE" -gt 0 ] || abort "$ENTRY is empty"

    resolve_targets "$PART"
    for TARGET in $TARGETS; do
        TARGET_SIZE="$(blockdev --getsize64 "$TARGET" 2>/dev/null)"
        is_uint "$TARGET_SIZE" || abort "Cannot read size of $TARGET"
        [ "$IMAGE_SIZE" -le "$TARGET_SIZE" ] ||
            abort "$NAME is larger than $TARGET"

        print_box "Flashing $(basename "$TARGET")"
        unzip -p "$ZIPFILE" "$ENTRY" > "$TARGET" 2> "$WORKDIR/unzip-$PART.log" ||
            abort "Failed flashing $(basename "$TARGET")"
    done
}

validate_efisp_target() {
    package_has_file "$EFISP_ENTRY" || abort "Missing $EFISP_ENTRY"
    IMAGE_SIZE="$(package_file_size "$EFISP_ENTRY")"
    is_uint "$IMAGE_SIZE" || abort "Cannot read size of $EFISP_ENTRY"
    [ "$IMAGE_SIZE" -gt 0 ] || abort "$EFISP_ENTRY is empty"

    EFISP_DEV="$BYNAME/efisp"
    [ -b "$EFISP_DEV" ] || abort "$EFISP_DEV is not a block device"
    TARGET_SIZE="$(blockdev --getsize64 "$EFISP_DEV" 2>/dev/null)"
    is_uint "$TARGET_SIZE" || abort "Cannot read size of $EFISP_DEV"
    [ "$IMAGE_SIZE" -le "$TARGET_SIZE" ] ||
        abort "$EFISP_ENTRY is larger than efisp"
}

flash_efisp_image() {
    validate_efisp_target
    print_box "Flashing efisp"
    unzip -p "$ZIPFILE" "$EFISP_ENTRY" > "$EFISP_DEV" \
        2> "$WORKDIR/unzip-efisp.log" || abort "Failed flashing efisp"
}

prepare_streamers() {
    package_has_file "$WRITER_ENTRY" || abort "Missing $WRITER_ENTRY"
    package_has_file "$ZIP_STREAMER_ENTRY" || abort "Missing $ZIP_STREAMER_ENTRY"

    unzip -p "$ZIPFILE" "$WRITER_ENTRY" > "$WRITER" 2>/dev/null ||
        abort "Cannot extract sparse writer"
    unzip -p "$ZIPFILE" "$ZIP_STREAMER_ENTRY" > "$ZIP_STREAMER" 2>/dev/null ||
        abort "Cannot extract ZIP streamer"

    chmod 0755 "$WRITER" || abort "Cannot make sparse writer executable"
    chmod 0755 "$ZIP_STREAMER" || abort "Cannot make ZIP streamer executable"
    [ -x "$WRITER" ] || abort "Sparse writer is not executable"
    [ -x "$ZIP_STREAMER" ] || abort "ZIP streamer is not executable"

    "$WRITER" > "$WORKDIR/sparse-writer-probe.log" 2>&1
    WRITER_PROBE_STATUS=$?
    [ "$WRITER_PROBE_STATUS" -eq 2 ] ||
        abort "Sparse writer cannot run in this recovery"
    grep -q "^Usage:" "$WORKDIR/sparse-writer-probe.log" ||
        abort "Sparse writer runtime probe failed"

    "$ZIP_STREAMER" > "$WORKDIR/zip-streamer-probe.log" 2>&1
    ZIP_STREAMER_PROBE_STATUS=$?
    [ "$ZIP_STREAMER_PROBE_STATUS" -eq 2 ] ||
        abort "ZIP streamer cannot run in this recovery"
    grep -q "STORED_ENTRY" "$WORKDIR/zip-streamer-probe.log" ||
        abort "ZIP streamer runtime probe failed"
}

flash_super_image() {
    package_has_file "$SUPER_ENTRY" || abort "Missing $SUPER_ENTRY"
    [ -b "$SUPER_DEV" ] || abort "$SUPER_DEV is not a block device"
    SUPER_DEVICE_BYTES="$(blockdev --getsize64 "$SUPER_DEV" 2>/dev/null)"
    is_uint "$SUPER_DEVICE_BYTES" || abort "Cannot read size of $SUPER_DEV"
    [ "$SUPER_DEVICE_BYTES" -ge "$TARGET_SUPER_BYTES" ] ||
        abort "Existing super is too small: $SUPER_DEVICE_BYTES < $TARGET_SUPER_BYTES"

    FIFO="$WORKDIR/super.sparse.fifo"
    rm -f "$FIFO"
    mkfifo "$FIFO" || abort "Cannot create sparse stream FIFO"

    print_box "Flashing super.img"
    print_box "Streaming directly to super"
    print_box "Writing $TARGET_SUPER_BYTES bytes"
    show_progress 0.65 900

    "$ZIP_STREAMER" "$ZIPFILE" "$SUPER_ENTRY" > "$FIFO" \
        2> "$WORKDIR/super-streamer.log" &
    ZIP_STREAMER_PID=$!

    WRITER_UI_FD=-1
    [ -n "$UI_PATH" ] && WRITER_UI_FD="$OUTFD"

    SUPER_WRITTEN=1
    "$WRITER" "$SUPER_DEV" 0 "$TARGET_SUPER_BYTES" "$WRITER_UI_FD" \
        < "$FIFO" > "$WORKDIR/super-writer.log" 2>&1
    WRITER_STATUS=$?

    wait "$ZIP_STREAMER_PID"
    ZIP_STREAMER_STATUS=$?
    rm -f "$FIFO"

    [ "$ZIP_STREAMER_STATUS" -eq 0 ] ||
        abort "Failed streaming super.img from package"
    [ "$WRITER_STATUS" -eq 0 ] || abort "Sparse super writer failed"

    print_box "Synchronizing super"
    sync
    print_box "super.img flashed"
}

for TOOL in unzip awk sed grep sort basename blockdev \
    umount mkdir chmod mkfifo sync getprop getevent rm; do
    command -v "$TOOL" >/dev/null 2>&1 ||
        abort "$TOOL is missing from recovery"
done

[ -f "$ZIPFILE" ] || abort "Package ZIP is unavailable"

rm -rf "$WORKDIR"
mkdir -p "$WORKDIR" || abort "Cannot create $WORKDIR"
prepare_device_profile

ui_print "###################################"
ui_print "#          OPLUS MODS             #"
ui_print "# $(printf '%-31.31s' "$DEVICE_DISPLAY") #"
ui_print "#       Recovery Super Flasher    #"
ui_print "###################################"
ui_print ""

PRJ_ID="$(getprop ro.boot.prjname 2>/dev/null)"
case " $SUPPORTED_PROJECT_IDS " in
    *" $PRJ_ID "*) print_box "Project ID $PRJ_ID accepted" ;;
    *) abort "Unsupported project ID: $PRJ_ID" ;;
esac

prepare_streamers
prepare_required_images
prepare_firmware_list
validate_efisp_target

set_progress 0.02
show_progress 0.15 20

confirm_install
ask_flash_abl
unmount_for_install

set_progress 0.15
show_progress 0.45 240

FIRMWARE_COUNT=0
while IFS= read -r ENTRY; do
    partition_for_entry "$ENTRY"

    case "$PART" in
        super)
            continue
            ;;
        recovery)
            print_box "Keeping current recovery"
            continue
            ;;
        abl)
            if [ "$FLASH_ABL" -ne 1 ]; then
                continue
            fi
            ;;
    esac

    flash_firmware_image "$ENTRY"
    FIRMWARE_COUNT=$((FIRMWARE_COUNT + 1))
done < "$FIRMWARE_LIST"

[ "$FIRMWARE_COUNT" -gt 0 ] || abort "No firmware images were flashed"
sync

flash_efisp_image
sync

set_progress 0.60
flash_super_image

set_progress 0.95
if command -v bootctl >/dev/null 2>&1; then
    print_box "Setting active slot A"
    bootctl set-active-boot-slot 0 >/dev/null 2>&1 ||
        abort "Failed setting active slot A"
elif [ -x /system/bin/bootctl ]; then
    print_box "Setting active slot A"
    /system/bin/bootctl set-active-boot-slot 0 >/dev/null 2>&1 ||
        abort "Failed setting active slot A"
else
    abort "bootctl is missing"
fi

sync
set_progress 1.0

ui_print ""
ui_print "###################################"
ui_print "#       Installation complete     #"
ui_print "###################################"
ui_print ""
print_box "Super: $TARGET_SUPER_BYTES bytes"
print_box "Format Data before Android"

cleanup
exit 0
